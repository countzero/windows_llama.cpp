{
    "$schema": "https://json.schemastore.org/claude-code-settings.json",
    "hooks": {
        "SessionStart": [
            {
                "matcher": "startup|resume|compact",
                "hooks": [
                    {
                        "type": "command",
                        "command": "powershell -NoProfile -Command \"'SESSION_ID=' + ([Console]::In.ReadToEnd() | ConvertFrom-Json).session_id\""
                    }
                ]
            }
        ]
    }
}
