+    pos = 0
+    for start in range(0, rows.shape[0], n_per_group):
+        group = func(rows[start:start + n_per_group]).ravel()
+        out[pos:pos + group.size] = group
+        pos += group.size
+    assert pos == osize
     return out.reshape(oshape)
 
 
